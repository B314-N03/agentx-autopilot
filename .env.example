# AgentX configuration — copy to .env and edit. (.env is gitignored.)

# Scope the savings report (`npm run report`) to sessions whose working
# directory is at/under this path — e.g. only your billable work sessions.
# Leave unset to include every project under ~/.claude/projects.
AGENTX_REPORT_ROOT=/Users/you/Coding/work

# --- Auto-switch (Phase 4 Path 2) --------------------------------------------
# Read by the Stop hook (bin/nudge.sh). 1 = auto-type `/model <tier>` into the
# live session on a downshift-worthy nudge; DRYRUN=1 logs the command instead.
# These are usually set where the hook is registered (your global
# ~/.claude/settings.json), and are listed here only for reference.
# AGENTX_AUTOSWITCH=0
# AGENTX_AUTOSWITCH_DRYRUN=0
